# Copiá este archivo como .env y completá los valores. El .env no se commitea.

# Obligatoria
DB_PASSWORD=

# Opcionales (estos son los valores por defecto)
SERVER_PORT=8082
DB_URL=jdbc:mysql://localhost:3306/catalog?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USER=catalog
JPA_SHOW_SQL=false

# HTTPS (apagado por defecto)
SSL_ENABLED=false
SSL_KEYSTORE_PATH=
SSL_KEYSTORE_PASSWORD=

# Otros servicios
USERS_VALIDATE_URL=http://localhost:8081/usuarios/validar
INVENTORY_STOCK_URL=http://localhost:8083/stock/
REVIEWS_RATING_URL=http://localhost:8087/reviews/rating/
