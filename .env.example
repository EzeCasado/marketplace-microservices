# Variables del docker-compose.yml. Copiá este archivo como .env y completá los valores.
# El .env no se commitea.

# ---------- Catálogo ----------
# Obligatoria: la contraseña del usuario catalog en su MySQL
CATALOG_DB_PASSWORD=
# Puerto de la MySQL del catálogo en la compu (solo 127.0.0.1)
CATALOG_DB_PORT=3307
